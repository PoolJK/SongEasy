<song version="1.0.1" numberOfMeasures="34">
   <textBlocks>
      <textBlock>
         <content>Du füllst deine großen Taschen
tief im Dreck doch ganz diskret
sammelst all die leeren Flaschen
damit es doch noch weiter geht</content>
         <title>3. Strophe</title>
      </textBlock>
      <textBlock>
         <content>Einen wie dich dürfts gar nicht geben
in diesem stolzen reichen Land
darum will man auch nicht sehen
wie man selber enden kann</content>
         <title>4. Strophe</title>
      </textBlock>
   </textBlocks>
