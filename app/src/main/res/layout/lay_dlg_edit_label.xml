<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <TextView
        android:id="@+id/textViewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="@string/label_annotation_label"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <EditText
        android:id="@+id/editTextAnnotationLabel"
        android:inputType="textAutoCorrect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/textViewLabel"
        android:ems="10" >

        <requestFocus />
    </EditText>

    <View
        android:id="@+id/horz_separator_line"
        android:layout_marginTop="5dp"
        android:layout_width="fill_parent"
        android:layout_height="1dp"
        android:layout_below="@id/editTextAnnotationLabel"
        android:layout_marginBottom="0dp"
        android:background="?android:attr/dividerHorizontal" />

    <include layout="@layout/lay_dlg_two_button"
        android:layout_below="@id/horz_separator_line"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"/>

</RelativeLayout>