<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" >

    <!-- android:background="#DDDEE3" -->
    <!-- android:background="@android:color/darker_gray" -->

    <ToggleButton
        android:id="@+id/toggleButtonAddNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/btn_toggle_note_4th"
        android:textOff=""
        android:textOn="" />
    
    <ToggleButton
        android:id="@+id/toggleButtonAddRest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/toggleButtonAddNote"
        android:background="@drawable/btn_toggle_rest_4th"
        android:textOff=""
        android:textOn="" />
    
    <ToggleButton
        android:id="@+id/toggleButtonAddChord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/toggleButtonAddRest"
        android:background="@drawable/btn_toggle_chord"
        android:textOff=""
        android:textOn="" />

    <ToggleButton
        android:id="@+id/toggleButtonAddText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/toggleButtonAddChord"
        android:background="@drawable/btn_toggle_text"
        android:textOff=""
        android:textOn="" />

    <ToggleButton
        android:id="@+id/toggleButtonAddAnnotation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/toggleButtonAddText"
        android:background="@drawable/btn_toggle_annotation"
        android:textOff=""
        android:textOn="" />
    
    <ToggleButton
        android:id="@+id/toggleButtonAddMeasure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/toggleButtonAddAnnotation"
        android:background="@drawable/btn_toggle_measure"
        android:textOff=""
        android:textOn="" />

    <ToggleButton
        android:id="@+id/toggleButtonSelectElement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/toggleButtonAddMeasure"
        android:background="@drawable/btn_toggle_select"
        android:textOff=""
        android:textOn="" />

    <ImageButton
        android:id="@+id/imageButtonDeleteElement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/toggleButtonSelectElement"
        android:src="@drawable/ic_content_remove" />

    <ImageButton
        android:id="@+id/imageButtonEditElement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/imageButtonDeleteElement"
        android:src="@drawable/btn_image_options" />

</merge>