<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:gravity="center_horizontal">
    <!-- android:background="@android:color/darker_gray" -->

    <de.songeasy.android.toolbar.ToolBarMain
        android:id="@+id/toolBarMain1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="5dp"
        android:background="#DDDEE3"
        android:orientation="horizontal">
    </de.songeasy.android.toolbar.ToolBarMain>

    <de.songeasy.android.toolbar.OperationBarSelect
        android:id="@+id/operationBarSelect1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:layout_toRightOf="@id/toolBarMain1"
        android:layout_alignParentBottom="true"
        android:background="#DDDEE3"
        android:orientation="horizontal"
        android:paddingRight="2dp">
    </de.songeasy.android.toolbar.OperationBarSelect>

    <de.songeasy.android.toolbar.OperationBarMove
        android:id="@+id/operationBarMove1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toRightOf="@id/operationBarSelect1"
        android:background="@null"
        android:orientation="horizontal">
    </de.songeasy.android.toolbar.OperationBarMove>

    <de.songeasy.android.toolbar.OperationBarMain
        android:id="@+id/operationBarMain1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="5dp"
        android:layout_toRightOf="@id/operationBarMove1"
        android:background="#DDDEE3"
        android:orientation="horizontal"
        android:paddingLeft="2dp">
    </de.songeasy.android.toolbar.OperationBarMain>

</RelativeLayout>
