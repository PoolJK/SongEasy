<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Non focused states -->
    <item android:state_focused="false" android:state_pressed="false" android:drawable="@drawable/toggle_move_normal_up" />
    <item android:state_focused="false" android:state_pressed="true" android:drawable="@drawable/toggle_move_pressed_up" />

    <!-- Focused states -->
    <item android:state_focused="true" android:state_pressed="false" android:drawable="@drawable/toggle_move_normal_up" />
    <item android:state_focused="true" android:state_pressed="true" android:drawable="@drawable/toggle_move_pressed_up" />

</selector>
